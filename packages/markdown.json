{
  "format": "et-doc-rules/1",
  "indent": 2,
  "comment_gap": 1,
  "blank_cap": 1,
  "tokens": [
    "block_continuation",
    "fenced_code_block_delimiter",
    "atx_h1_marker",
    "atx_h2_marker",
    "atx_h3_marker",
    "atx_h4_marker",
    "atx_h5_marker",
    "atx_h6_marker",
    "block_quote_marker",
    "list_marker_minus",
    "list_marker_plus",
    "list_marker_star",
    "list_marker_dot",
    ":",
    "|"
  ],
  "comments": [],
  "descend": [],
  "gap_owner": {
    "list": [
      "list_item"
    ]
  },
  "blank_owner": [
    "indented_code_block"
  ],
  "rules": {
    "document": [
      "use",
      "hard_blocks"
    ],
    "section": [
      "use",
      "blocks"
    ],
    "paragraph": [
      "verbatim"
    ],
    "inline": [
      "verbatim"
    ],
    "html_block": [
      "verbatim"
    ],
    "atx_heading": [
      "seq",
      [
        "child",
        "*"
      ],
      [
        "sp"
      ],
      [
        "child",
        "f:heading_content"
      ],
      [
        "hard"
      ]
    ],
    "setext_heading": [
      "seq",
      [
        "child",
        "f:heading_content"
      ],
      [
        "child",
        "*"
      ],
      [
        "hard"
      ]
    ],
    "block_quote": [
      "seq",
      [
        "child",
        "t:block_quote_marker"
      ],
      [
        "use",
        "hard_blocks"
      ]
    ],
    "list": [
      "seq",
      [
        "use",
        "tight"
      ],
      [
        "blank",
        1
      ]
    ],
    "list_item": [
      "seq",
      [
        "child",
        "*"
      ],
      [
        "when",
        [
          "count",
          "named",
          0
        ],
        [
          "hard"
        ],
        [
          "seq"
        ]
      ],
      [
        "opt",
        "t:task_list_marker_unchecked",
        [
          "seq",
          [
            "child",
            "t:task_list_marker_unchecked"
          ],
          [
            "sp"
          ]
        ]
      ],
      [
        "opt",
        "t:task_list_marker_checked",
        [
          "seq",
          [
            "child",
            "t:task_list_marker_checked"
          ],
          [
            "sp"
          ]
        ]
      ],
      [
        "use",
        "tight"
      ],
      [
        "opt",
        "t:block_continuation",
        [
          "seq",
          [
            "blank",
            1
          ],
          [
            "child",
            "t:block_continuation"
          ]
        ]
      ]
    ],
    "indented_code_block": [
      "verbatim"
    ],
    "fenced_code_block": [
      "seq",
      [
        "child",
        "t:fenced_code_block_delimiter"
      ],
      [
        "opt",
        "t:info_string",
        [
          "child",
          "t:info_string"
        ]
      ],
      [
        "when",
        [
          "count",
          "t:code_fence_content",
          1
        ],
        [
          "seq",
          [
            "opt",
            "t:block_continuation",
            [
              "seq",
              [
                "hard"
              ],
              [
                "child",
                "t:block_continuation"
              ]
            ]
          ],
          [
            "opt",
            "named",
            [
              "seq",
              [
                "srcgap"
              ],
              [
                "child",
                "named"
              ]
            ]
          ],
          [
            "srcgap"
          ],
          [
            "child",
            "t:fenced_code_block_delimiter"
          ]
        ],
        [
          "prefix",
          "t:block_continuation",
          [
            "hard"
          ],
          [
            "opt",
            "named",
            [
              "child",
              "named"
            ]
          ],
          [
            "hard"
          ],
          [
            "child",
            "t:fenced_code_block_delimiter"
          ]
        ]
      ],
      [
        "hard"
      ],
      [
        "opt",
        "t:block_continuation",
        [
          "child",
          "t:block_continuation"
        ]
      ]
    ],
    "info_string": [
      "verbatim"
    ],
    "code_fence_content": [
      "verbatim"
    ],
    "link_reference_definition": [
      "seq",
      [
        "child",
        "t:link_label"
      ],
      [
        "tok",
        ":"
      ],
      [
        "sp"
      ],
      [
        "child",
        "t:link_destination"
      ],
      [
        "opt",
        "t:link_title",
        [
          "seq",
          [
            "sp"
          ],
          [
            "child",
            "t:link_title"
          ]
        ]
      ],
      [
        "hard"
      ]
    ],
    "link_label": [
      "verbatim"
    ],
    "link_destination": [
      "verbatim"
    ],
    "link_title": [
      "verbatim"
    ],
    "pipe_table": [
      "table"
    ]
  },
  "defs": {
    "blocks": [
      "each",
      "named",
      [
        "seq",
        [
          "blank",
          1,
          [
            "list",
            "section",
            "fenced_code_block",
            "block_quote",
            "pipe_table",
            "paragraph",
            "atx_heading",
            "setext_heading",
            "thematic_break",
            "link_reference_definition"
          ]
        ],
        [
          "opt",
          "t:block_continuation",
          [
            "child",
            "t:block_continuation"
          ]
        ]
      ]
    ],
    "tight": [
      "each",
      "named",
      [
        "seq",
        [
          "blank",
          1
        ],
        [
          "opt",
          "t:block_continuation",
          [
            "child",
            "t:block_continuation"
          ]
        ]
      ]
    ],
    "hard_blocks": [
      "each",
      "named",
      [
        "seq",
        [
          "hard"
        ],
        [
          "opt",
          "t:block_continuation",
          [
            "child",
            "t:block_continuation"
          ]
        ]
      ]
    ]
  }
}
