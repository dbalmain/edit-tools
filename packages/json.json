{
  "format": "et-doc-rules/1",
  "indent": 2,
  "tokens": ["{", "}", "[", "]", ",", ":"],
  "comments": [],
  "descend": [],
  "optional_parens": [],
  "precedence": {},

  "defs": {
    "fitting_array": [
      "group",
      ["tok", "["],
      ["indent", ["soft"], ["$", 0]],
      ["soft"],
      ["tok", "]"]
    ]
  },

  "rules": {
    "document": ["child", "named"],

    "object": [
      "when",
      ["count", "t:pair", 0],
      ["seq", ["tok", "{"], ["tok", "}"]],
      [
        "group",
        ["tok", "{"],
        [
          "indent",
          ["line"],
          ["each", "t:pair", ["seq", ["tok", ","], ["line"]]]
        ],
        ["line"],
        ["tok", "}"]
      ]
    ],

    "array": [
      "when",
      ["count", "named", 0],
      ["seq", ["tok", "["], ["tok", "]"]],
      [
        "when",
        ["all", "named", ["number"]],
        ["use", "fitting_array", ["fill", "named", ["seq", ["tok", ","], ["line"]]]],
        [
          "when",
          ["all", "named", ["array", "object"]],
          [
            "when",
            ["count", "named", 1],
            ["use", "fitting_array", ["each", "named", ["seq", ["tok", ","], ["line"]]]],
            [
              "seq",
              ["tok", "["],
              [
                "indent",
                ["hard"],
                ["each", "named", ["seq", ["tok", ","], ["hard"]]]
              ],
              ["hard"],
              ["tok", "]"]
            ]
          ],
          ["use", "fitting_array", ["each", "named", ["seq", ["tok", ","], ["line"]]]]
        ]
      ]
    ],

    "pair": [
      "seq",
      ["child", "f:key"],
      ["tok", ":"],
      ["sp"],
      ["child", "f:value"]
    ],

    "string": ["verbatim"]
  }
}
