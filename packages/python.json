{
  "language": "python",
  "indent": 4,
  "opaque": ["string"],
  "blank": {
    "max": 2,
    "before_top": [
      "function_definition",
      "class_definition",
      "decorated_definition"
    ]
  },
  "nodes": {
    "module": { "kind": "body" },
    "block": { "kind": "body" },
    "expression_statement": { "kind": "fwd" },
    "assignment": { "kind": "infix", "op": " = " },
    "list": {
      "kind": "seq",
      "open": "[",
      "close": "]",
      "sep": ",",
      "trailing": "magic"
    },
    "dictionary": {
      "kind": "seq",
      "open": "{",
      "close": "}",
      "sep": ",",
      "trailing": "magic"
    },
    "tuple": {
      "kind": "seq",
      "open": "(",
      "close": ")",
      "sep": ",",
      "trailing": "magic",
      "singleton_comma": true
    },
    "set": {
      "kind": "seq",
      "open": "{",
      "close": "}",
      "sep": ",",
      "trailing": "magic"
    },
    "pair": { "kind": "infix", "op": ": " },
    "call": { "kind": "pfx", "fields": ["function", "arguments"] },
    "argument_list": {
      "kind": "seq",
      "open": "(",
      "close": ")",
      "sep": ",",
      "trailing": "magic"
    },
    "keyword_argument": { "kind": "infix", "op": "=" },
    "list_splat": { "kind": "pfx", "kw": "*", "sp": false },
    "dictionary_splat": { "kind": "pfx", "kw": "**", "sp": false },
    "parenthesized_expression": { "kind": "wrap", "open": "(", "close": ")" },
    "binary_operator": { "kind": "chain", "break": "paren" },
    "boolean_operator": { "kind": "chain", "break": "paren" },
    "comparison_operator": {
      "kind": "chain",
      "already_flat": true,
      "break": "paren"
    },
    "not_operator": { "kind": "pfx", "kw": "not", "sp": true, "paren": true },
    "unary_operator": { "kind": "pfx", "op_field": "operator", "sp": false }
  }
}
