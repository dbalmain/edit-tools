{
  "format": "et-linear-layout/1",
  "language": "python",
  "style": { "indent": 4, "finalNewline": false },
  "rules": {
    "module": { "layout": "source" },
    "expression_statement": { "layout": "source" },
    "assignment": { "layout": "source" },
    "call": { "layout": "source" },
    "function_definition": { "layout": "source" },
    "decorated_definition": { "layout": "source" },

    "argument_list": { "layout": "delimited", "open": "(", "close": ")", "separator": ",", "edge": "softline", "itemsVerbatim": true, "preserveTrailing": true, "forceTrailing": true, "independentItems": true },
    "parameters": { "layout": "delimited", "open": "(", "close": ")", "separator": ",", "edge": "softline", "itemsVerbatim": true, "preserveTrailing": false, "forceTrailing": false, "independentItems": true, "reserveLineSuffix": true },

    "attribute": { "layout": "verbatim" },
    "augmented_assignment": { "layout": "verbatim" },
    "binary_operator": { "layout": "verbatim" },
    "block": { "layout": "verbatim" },
    "boolean_operator": { "layout": "verbatim" },
    "class_definition": { "layout": "verbatim" },
    "comparison_operator": { "layout": "verbatim" },
    "concatenated_string": { "layout": "verbatim" },
    "conditional_expression": { "layout": "verbatim" },
    "decorator": { "layout": "verbatim" },
    "dictionary": { "layout": "delimited", "open": "{", "close": "}", "separator": ",", "edge": "softline", "itemsVerbatim": true, "preserveTrailing": true, "forceTrailing": true, "independentItems": true, "verbatimWithComments": true },
    "dictionary_comprehension": { "layout": "flow", "open": "{", "close": "}", "edge": "softline", "itemsVerbatim": true, "independentItems": true },
    "for_statement": { "layout": "verbatim" },
    "generator_expression": { "layout": "flow", "open": "(", "close": ")", "edge": "softline", "itemsVerbatim": true, "independentItems": true },
    "generic_type": { "layout": "verbatim" },
    "if_statement": { "layout": "verbatim" },
    "import_from_statement": { "layout": "continuationList", "marker": "import", "open": "(", "close": ")", "separator": ",", "addTrailing": true },
    "import_statement": { "layout": "verbatim" },
    "lambda": { "layout": "verbatim" },
    "list": { "layout": "delimited", "open": "[", "close": "]", "separator": ",", "edge": "softline", "itemsVerbatim": true, "preserveTrailing": true, "forceTrailing": true, "independentItems": true, "verbatimWithComments": true },
    "list_comprehension": { "layout": "flow", "open": "[", "close": "]", "edge": "softline", "itemsVerbatim": true, "independentItems": true },
    "not_operator": { "layout": "verbatim" },
    "pattern_list": { "layout": "verbatim" },
    "set": { "layout": "delimited", "open": "{", "close": "}", "separator": ",", "edge": "softline", "itemsVerbatim": true, "preserveTrailing": true, "forceTrailing": true, "independentItems": true, "verbatimWithComments": true },
    "set_comprehension": { "layout": "flow", "open": "{", "close": "}", "edge": "softline", "itemsVerbatim": true, "independentItems": true },
    "string": { "layout": "verbatim" },
    "subscript": { "layout": "verbatim" },
    "try_statement": { "layout": "verbatim" },
    "tuple": { "layout": "delimited", "open": "(", "close": ")", "separator": ",", "edge": "softline", "itemsVerbatim": true, "preserveTrailing": true, "forceTrailing": false, "independentItems": true, "verbatimWithComments": true },
    "type": { "layout": "verbatim" },
    "unary_operator": { "layout": "verbatim" },
    "while_statement": { "layout": "verbatim" },
    "with_statement": { "layout": "verbatim" }
  }
}
