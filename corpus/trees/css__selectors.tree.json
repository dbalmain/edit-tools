 "source_file": "corpus/src/css/selectors.css",
 "source": "/* Selectors: lists, combinators, attributes, :is/:has. */\n\n/* Comma lists are always one selector per line, whatever the width. */\n.header,\n.footer,\n.sidebar,\n.main-content {\n  color: inherit;\n}\n\n/* Combinators, attributes, trailing comment. */\nnav > ul + p ~ a[href=\"https://example.com\"][target=\"_blank\"] {\n  color: blue; /* external link */\n}\n\n/* :is descendant wraps at 40, not at 80. */\n:is(header, footer, aside) a:not(:hover, :focus) {\n  color: navy;\n}\n\n:where(.teaser, .card, .panel) {\n  margin: 0;\n}\n\narticle:has(> img + p) {\n  display: grid;\n}\n",
