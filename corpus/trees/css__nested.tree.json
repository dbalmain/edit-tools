 "source": "/* Nested at-rules and a function whose children fit. */\n\n@media screen and (min-width: 768px) {\n  @supports (display: grid) and (gap: 1rem) and (not (display: -ms-grid)) {\n    .hero {\n      /* rgb() fits after linear-gradient breaks; stays flat */\n      background: linear-gradient(90deg, rgb(1, 2, 3), rgb(4, 5, 6), rgb(7, 8, 9), rgb(10, 11, 12));\n      font-family: \"Helvetica Neue\", \"Arial\", \"sans-serif\", \"Georgia\", \"Times New Roman\", \"Courier New\";\n    }\n  }\n}\n",
