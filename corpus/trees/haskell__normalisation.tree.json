 "source": "module Normalisation where\n-- token-level mess: spacing, delimiter padding, indent, empty containers\n-- no blank line after the module header either: ormolu inserts one\nxs = [ ]\nunit = ( )\npair = ( 1,2 )\nlst = [ 1,2,3 ]\nadd a b=a+b\nscale x=x*  2+1\npadded ( a , b ) = a + b\nweird x=x+1       -- lots of spaces before this comment\nnested = ((1))\nkept = (1 + 2)\nemptyUpdate r = r { }\npacked = do x<-pure 1;pure x\nindented = do\n      n <- pure 0\n      if n==0 then pure 1 else pure n\n",
