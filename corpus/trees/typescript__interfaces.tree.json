 "source_file": "corpus/src/typescript/interfaces.ts",
 "source": "// Interfaces: members, extends lists, and the signatures an interface can hold.\n// A one-member interface expands even when it fits; that is not objectWrap.\ninterface Point {\n  readonly x: number;\n  y: number;\n  z?: number;\n  label: string;\n}\n\ninterface Named { name: string }\n\ninterface LabeledPoint extends Point, Named, Timestamped {\n  extra: boolean;\n}\n\ninterface Wide extends FirstLongBase, SecondLongBase, ThirdLongBase, FourthLongBase {\n  extra: number;\n}\n\ninterface Callable {\n  (x: number): string;\n  new (x: number): Thing;\n  [key: string]: number | string;\n  method(this: Callable): void;\n}\n\ninterface Accessors {\n  get value(): number;\n  set value(next: number);\n}\n",
