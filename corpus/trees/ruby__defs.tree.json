 "source": "# Methods, classes, modules. Headers are already parenthesised: syntax_tree\n# adds parens to `def foo a, b` and would make that a token rewrite.\n\nclass Widget < Base\n  attr_reader :name, :age\n\n  def initialize(name, age)\n    @name = name\n    @age = age\n  end\n\n  def self.build(name, age = 0)\n    new(name, age)\n  end\n\n  def configure(host:, port: 80, timeout: 30, retries: 3)\n    @host = host\n    @port = port\n  end\nend\n\nmodule Helpers\n  module_function\n\n  def shout(text)\n    text.upcase # trailing\n  end\nend\n\ndef add(x) = x + 1\n\ndef forward(...)\n  bar(...)\nend\n\nclass << self\n  def singleton_hook\n    1\n  end\nend\n",
