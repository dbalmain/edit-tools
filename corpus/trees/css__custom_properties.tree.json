 "source": "/* Custom properties: values are token soup. */\n\n:root {\n  --space-sm: 0.5rem;\n  --fg: #111111;\n  /* color-mix stays together until it overflows */\n  --token-soup: 1px solid color-mix(in oklab, var(--fg) 80%, transparent);\n  --list: 0 1px 2px rgba(0, 0, 0, 0.1), 0 2px 4px rgba(0, 0, 0, 0.08), 0 4px 8px rgba(0, 0, 0, 0.06);\n}\n\n.panel {\n  color: var(--fg, #111111);\n  margin: var(--space-sm, 0.5rem) var(--space-md, 1rem);\n  border: var(--token-soup);\n}\n",
