 "language": "kotlin",
 "source_file": "corpus/src/kotlin/chains.kt",
 "source": "// Safe-call / Elvis spines and method chains that break at the dots.\n\nfun cityOf(user: User?): String = user ?. profile ?. address ?. city ?: \"unknown\"\n\nfun demo(user: User?, items: List<Item>): String {\n    val city = user?.profile?.address?.city ?. uppercase() ?. trim() ?. take(10) ?: defaultCity\n    val names = items.filter { it.isActive }.map { it.name }.sortedBy { it.length }.take(10).joinToString()\n    return city + names // both spines\n}\n\nclass User(val profile: Profile?)\n\nclass Profile(val address: Address?)\n\nclass Address(val city: String)\n\nclass Item(val name: String, val isActive: Boolean)\n\nval defaultCity = \"nowhere\"\n",
