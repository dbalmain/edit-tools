 "language": "typescript",
 "source_file": "corpus/src/typescript/normalisation.ts",
 "source": "// Input written the way a person writes it and prettier does not: wrong spacing\n// around operators, colons and delimiters, padding inside brackets, wrong\n// indentation, runs of spaces before a trailing comment. Empty containers are\n// written with a space inside — the shape whose node has no named children.\nfunction weird( a : string , b:number ){\n    const result:number=a.length+b* 2;\n    return result;\n}\n\nconst emptyCall = f( );\nconst emptyArray = [ ];\nconst emptyObject = { };\ntype EmptyType = { };\ninterface EmptyInterface { }\ntype EmptyTuple = [ ];\nfunction emptyParams( ) {\n  return 1;\n}\n\nconst padded: number[]=[ 1,2,3 ];\nconst tight: Record<string, number>={ x:1,y:2 };\nconst spaced = { a : 1 , b : 2 };\nconst genericCall = identity< string , number >( 1 );\n\nconst redundant = ((1 + 2));\n\nif ( x ){ y=1 }else{ y=2 }\n\nconst trailingSpaces: number = 1       // lots of spaces before this comment\n\nconst beforeGap = 1;\n\n\n\n\nconst afterGap = 2;\n\nfunction indented(): number {\n\t\tconst n: number = 0;\n\t\tif (n === 0) {\n\t\t\t\treturn 1;\n\t\t}\n\t\treturn n;\n}\n",
