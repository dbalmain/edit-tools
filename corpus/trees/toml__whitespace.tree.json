 "source": "# Hand-written TOML that nobody ran a formatter over: the token-level whitespace\n# taplo normalises, as opposed to the line-breaking decisions the rest of the\n# corpus probes. Spacing around `=`, padding inside `[` and `{`, spacing around\n# `,` and `.`, indentation under a table header, and the run of spaces before a\n# trailing `#` are each written wrong here on purpose.\n\nname    =    \"spaced out\"\ncompact=\"no spaces at all\"\nmixed = \"one side\"\n\ttabbed_key = \"leading tab\"\n\npadded_array = [ 1, 2, 3 ]\ncomma_spacing = [1 ,2 , 3,4]\ntight_array = [1,2,3]\npadded_and_tight = [ {a=1}, {b = 2} ]\n\ntight_table = {host=\"localhost\",port=5432}\npadded_table = {  host = \"remote\" ,  port = 5433  }\n\ndotted . key . chain = \"spaces around the dots\"\n\n[  section  ]\n    indented = true\n    also_indented = \"four spaces under the header\"\n\ttab_indented = \"one tab under the header\"\n\n[ outer . inner ]\nvalue    = 1    #    a trailing comment behind a run of spaces\nother = 2\t# behind a tab\n\n# NB: `[[  items  ]]` — an array-of-tables header padded inside the double\n# brackets — is legal TOML but taplo 0.10.0 *rejects* it (\"expected identifier\"),\n# while tree-sitter-toml parses it without an ERROR node. It is therefore kept\n# out of the corpus deliberately; see the report.\n[[items]]\nid=1\n\n[[items]]\nid   =   2\n",
