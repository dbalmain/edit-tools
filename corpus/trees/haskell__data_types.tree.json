 "source": "module DataTypes where\n\n-- algebraic types, records, newtypes, deriving\ndata Colour = Red | Green | Blue deriving (Eq, Show) -- sum, no fields\n\ndata Pair a b = Pair a b deriving (Eq, Show)\n\ndata Person = Person\n  { personName :: String\n  , personAge :: Int\n  } -- record with leading commas\n\nnewtype Tagged a = Tagged {unTagged :: a} deriving (Eq, Show)\n\ndata Tree a\n  = Leaf a\n  | Branch (Tree a) (Tree a)\n  deriving (Eq, Show)\n\nemptyPerson = Person {personName = \"\", personAge = 0} -- record construction\n",
