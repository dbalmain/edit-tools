 "source": "// Comments in every position TypeScript allows, including type-level ones.\n\nconst value: number = 1; // trailing comment on a statement\n\n// Own-line comment before a declaration, separated by nothing.\nconst documented: number = 2;\n\ninterface Documented {\n  // comment before the first member\n  first: number;\n  second: string; // trailing on a member\n  // comment before the closing brace\n}\n\ntype Union = Alpha | /* mid-union block comment */ Beta | Gamma;\n\ntype Piped = Alpha | // trailing on the first member\n  Beta;\n\nfunction annotated<T /* on a type parameter */, U>(x: T): U {\n  // leading comment inside the body\n  const result = x as unknown as U; // trailing on an assignment\n  // comment before the return\n  return result;\n}\n\ntype Inner = Promise</* inside type arguments */ string>;\n\nconst collapsed: number[] = [ // comment right after the opening bracket\n  alpha,\n  beta,\n  gamma,\n];\n\nenum Flags {\n  // comment before the first member\n  On = 1, // trailing on a member\n  Off = 0,\n  // comment before the closing brace\n}\n\n/** JSDoc on a type alias. */\ntype Aliased = number;\n\n// Comment at the end of the file.\n",
