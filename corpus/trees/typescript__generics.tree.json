 "source": "// Generics with long parameter lists, constraints, defaults, and the arrow\n// form that only the TypeScript grammar (not TSX) accepts.\nfunction map<TFirst extends string, TSecond extends number, TThird extends boolean>(a: TFirst, b: TSecond, c: TThird): TFirst {\n  return a;\n}\n\nfunction defaults<T = string, U extends number = number, V extends T[] = T[]>(x: T, y: U): V {\n  return [x] as V;\n}\n\nfunction constParam<const T extends readonly string[]>(names: T): T {\n  return names;\n}\n\nconst identity = <T>(value: T): T => value;\n\nconst boxed = identity<string>(\"hello\");\n\nconst pair = makePair<string, number>(\"port\", 8080);\n\ninterface Box<T extends { id: string }, U = T> {\n  value: T;\n  extra?: U;\n}\n\nclass Store<K extends string, V> {\n  get(key: K): V | undefined {\n    return undefined;\n  }\n}\n\ntype Nested = Map<string, Promise<Set<ReadonlyArray<number>>>>;\n",
