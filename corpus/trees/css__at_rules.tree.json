 "source": "/* At-rules. @media never wraps; @supports wraps at 40. */\n\n@import url(\"theme.css\");\n@import \"print.css\" print;\n\n@layer reset, theme, components;\n\n@layer components {\n  .btn {\n    color: red; /* layer-local */\n  }\n}\n\n@media screen and (min-width: 768px) and (max-width: 1024px) and (orientation: landscape) and (prefers-color-scheme: dark) {\n  .x {\n    color: red;\n  }\n}\n\n@supports (display: grid) and (gap: 1rem) and (not (display: -ms-grid)) {\n  .grid {\n    display: grid;\n  }\n}\n",
