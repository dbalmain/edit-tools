 "source_file": "corpus/src/kotlin/functions.kt",
 "source": "// Named and default arguments, extensions, infix, operator, vararg.\n\nfun build(host:String=\"localhost\", port:Int=8080, debug:Boolean=false):String {\n    return \"$host:$port\" // defaulted\n}\n\nfun String.shout( ):String=this.uppercase() // extension\n\ninfix fun Int.times(word:String):String=word.repeat(this)\n\noperator fun Point.plus(other:Point):Point=Point(x+other.x,y+other.y)\n\nfun join(prefix:String,vararg parts:String):String {\n    return parts.joinToString(prefix=prefix)\n}\n\nfun demo() {\n    val built=build(port=443,host=\"example.com\") // named, reordered\n    val yelled=\"hi\".shout()\n    val repeated=3 times \"na\"\n    val summed=Point(1,2)+Point(3,4)\n    val joined=join(\":\",\"a\",\"b\",\"c\")\n}\n\ndata class Point(val x: Int, val y: Int)\n",
