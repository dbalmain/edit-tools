 "source_file": "corpus/src/toml/kitchen.toml",
 "source": "# Several constructs interacting. The one file allowed to be messy.\n\n# Service config: root pairs, dotted keys, tables, arrays of tables,\n# inline tables, comments in two positions, a long array that reflows.\n\nname = \"edge-proxy\"\nrevision = 17\nlisten = { host = \"0.0.0.0\", port = 8443 } # inline on a root pair\nfeatures = [\"http2\", \"gzip\", \"access-log\", \"proxy-protocol\", \"tls-session-tickets\"]\n\n[upstream.primary]\nurl = \"https://origin.example.com/api/v1\"\ntimeout = 30\nheaders = { authorization = \"Bearer placeholder\", accept = \"application/json\" }\n\n[upstream.primary.tls]\nalpn = [\"h2\", \"http/1.1\"]\nsni = \"origin.example.com\"\n\n# Canaries share the primary's path prefix via dotted keys mixed with tables.\nupstream.canary.weight = 5\nupstream.canary.url = \"https://canary.example.com/api/v1\"\n\n[[middlewares]]\nname = \"ratelimit\"\nparams = { requests = 100, window = \"1m\", burst = 20 }\n\n[[middlewares]]\nname = \"rewrite\"\n# comment attached to the next pair, not the header\npaths = [\"/v1\", \"/v2\", \"/internal/healthz\", \"/internal/readyz\", \"/metrics\"]\n\n[[middlewares]]\nname = \"auth\"\nskip = true\n\n[logging]\nlevel = \"info\"\nformat = \"\"\"\n{timestamp} {level} {target}\n{message}\n\"\"\"\n# trailing comment at the end of the kitchen\n",
