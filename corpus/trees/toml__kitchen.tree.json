 "source": "# A small project manifest exercising tables, arrays, inline tables, dotted keys\n# and comments together. The one file allowed to be messy.\n\n[package]\nname = \"example\"\nversion = \"0.1.0\"\ndescription = \"An example project for exercising the formatter on many constructs at once\"\n\n[dependencies]\nserde = { version = \"1.0\", features = [\"derive\"] }  # derive is the important bit\ntokio = { version = \"1\", features = [\"full\"] }\nthiserror = \"1.0\"\n\n[features]\ndefault = [\"std\", \"alloc\"]\nstd = []\nalloc = [\"dep:libc\"]\n\n[[bin]]\nname = \"example\"\npath = \"src/main.rs\"\n\n[profile.release]\nopt-level = 3\nlto = true\ncodegen-units = 1\ndebug = false\n\n# A dotted key that belongs to the profile.release table.\nprofile.release.panic = \"abort\"\n",
