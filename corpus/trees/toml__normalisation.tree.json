 "language": "toml",
 "source_file": "corpus/src/toml/normalisation.toml",
 "source": "# Written the way a person writes TOML and taplo does not. Every other file in\n# this corpus probes what taplo *breaks*; this one probes what it *rewrites*.\n# Nothing here is about line width -- each rewrite happens at every width.\n\n# Spacing around `=`, which people align by hand and taplo collapses.\nname     =    \"normalisation\"\nversion=\"0.1.0\"\nenabled       =        true\n\n# Leading indentation, which TOML allows and taplo strips.\n    indented = \"leading whitespace before a root pair\"\n\ttabbed = \"a tab, not spaces\"\n\n# Padding inside array brackets, and spacing around the commas.\npadded = [ 1 , 2 , 3 ]\ntight = [1,2,3]\ntrailing_space_run = [ \"a\" ,  \"b\" ]\n\n# Inline tables are the mirror image: taplo pads them out rather than in.\ncompact = {x=1,y=2}\nhalf_padded = { x = 1,y=2 }\n\n# Runs of spaces before a trailing comment, which taplo re-lays out and then\n# aligns against its siblings.\nport = 8080          # many spaces before this one\nhost = \"localhost\"\t# a tab before this one\n\n# Dotted keys, where the dots may be surrounded by whitespace and are not.\nserver   .   host = \"alpha.example.com\"\nserver.  port = 8080\n\n# Table headers, where the brackets and the dots may both be padded.\n[ owners ]\nprimary = \"platform\"\n\n[ deploy . staging ]\nregion = \"us-east-1\"\n\n\n\n# Three or more blank lines above; taplo caps a run at two.\nreplicas = 2\n",
