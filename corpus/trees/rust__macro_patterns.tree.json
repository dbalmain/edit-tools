 "source": "// Macro token trees whose separators are not commas. The comma-list branch of\n// `token_tree` is only correct when every child is content or list punctuation;\n// an or-pattern, a guard, a path, or a range inside a macro is token soup and\n// has to go through `verbatim` instead.\nfn classify(tag: Tag, count: usize) -> bool {\n    let is_short = matches!(tag, ShortOne | ShortTwo | ShortThree);\n    let is_guarded = matches!(count, n if n > 0);\n    let in_range = matches!(count, 1..=9);\n    let is_path = matches!(tag, crate::tags::Wide);\n    is_short && is_guarded && in_range && is_path\n}\n\nfn shout(name: &str, count: usize) -> String {\n    // A plain comma list, which the formatted branch does handle.\n    format!(\"{}: {}\", name, count)\n}\n",
