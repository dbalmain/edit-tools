 "source": "# The same data, written every legal way. taplo must not collapse these:\n# a formatter that turned [a.b] into [a][b] (or inline into a header)\n# would be making a semantic-ish choice the IR is not meant to make.\n\n# 1. dotted table header vs nested headers\n[spelling.dotted]\nx = 1\n\n[spelling.nested]\n[spelling.nested.child]\nx = 1\n\n# 2. inline table vs table header\ninline = { name = \"foo\", version = \"1.0.0\" }\n\n[as_table]\nname = \"foo\"\nversion = \"1.0.0\"\n\n# 3. array of tables vs array of inline tables\nas_inline_array = [{ host = \"a\", port = 1 }, { host = \"b\", port = 2 }]\n\n[[as_table_array]]\nhost = \"a\"\nport = 1\n\n[[as_table_array]]\nhost = \"b\"\nport = 2\n\n# 4. dotted keys vs a table of the same path\ndotted.host = \"localhost\"\ndotted.port = 8080\n\n[explicit]\nhost = \"localhost\"\nport = 8080\n",
