 "source": "// Decorators on classes, methods, properties, parameters, plus a factory whose\n// argument list reflows at the narrow width.\n@sealed\nclWorker {\n  run(): voids Service {\n  @optional\n  name: string = \"default\";\n\n  constructor(@inject private readonly db: Database) {}\n\n  @bound\n  method(): number {\n    return 1;\n  }\n\n  @logged(\"debug\", { verbose: true, timestamp: true, requestId: \"unset\" })\n  fetch(url: string): Promise<string> {\n    return load(url);\n  }\n}\n\n@logged(\"info\", { verbose: false })\nclass Worker {\n  run(): void {}\n}\n",
 "base_source": "// Decorators on classes, methods, properties, parameters, plus a factory whose\n// argument list reflows at the narrow width.\n@sealed\nclass Service {\n  @optional\n  name: string = \"default\";\n\n  constructor(@inject private readonly db: Database) {}\n\n  @bound\n  method(): number {\n    return 1;\n  }\n\n  @logged(\"debug\", { verbose: true, timestamp: true, requestId: \"unset\" })\n  fetch(url: string): Promise<string> {\n    return load(url);\n  }\n}\n\n@logged(\"info\", { verbose: false })\nclass Worker {\n  run(): void {}\n}\n",
